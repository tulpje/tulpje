  "query": "UPDATE jobs\nSET\n\tstatus = 'busy',\n\tattempts_remaining = attempts_remaining - 1,\n\tlast_retrieved_at = NOW()\nWHERE uuid IN (\n\tSELECT\n\t\tuuid\n\tFROM\n\t\tjobs\n\tWHERE\n\t\tstatus = 'pending'\n\t\tAND\tattempts_remaining > 0\n\t\tAND\tqueue = $1\n\tORDER BY\n\t\tpriority DESC\n\tLIMIT 1\n\tFOR UPDATE SKIP LOCKED\n)\nRETURNING\n\tuuid,\n  name,\n\tdata,\n\tattempts_remaining AS \"attempts_remaining: i8\";\n",
